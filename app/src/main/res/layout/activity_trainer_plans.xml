<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_page"
        android:paddingBottom="@dimen/space_sm">

        <ImageButton
            android:id="@+id/trainer_back_button"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_back"
            android:padding="@dimen/space_md"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/trainer_title"
            android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_page"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_page"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trainer_subtitle"
                android:textAppearance="@style/TextAppearance.Fitness.Metadata" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fitness.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                app:cardBackgroundColor="@color/color_mint">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_page">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sample_profile" android:textAppearance="@style/TextAppearance.Fitness.Metadata" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_maya" android:textAppearance="@style/TextAppearance.Fitness.CardTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/trainer_maya_plan" android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_maya_detail" android:textAppearance="@style/TextAppearance.Fitness.Metadata" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_maya_description" android:textAppearance="@style/TextAppearance.Fitness.Body" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/trainer_schedule_label" android:textAppearance="@style/TextAppearance.Fitness.CardTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_maya_schedule" android:textAppearance="@style/TextAppearance.Fitness.Body" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/follow_maya_button" style="@style/Widget.Fitness.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/follow_this_plan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fitness.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_page">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sample_profile" android:textAppearance="@style/TextAppearance.Fitness.Metadata" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_jordan" android:textAppearance="@style/TextAppearance.Fitness.CardTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/trainer_jordan_plan" android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_jordan_detail" android:textAppearance="@style/TextAppearance.Fitness.Metadata" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_jordan_description" android:textAppearance="@style/TextAppearance.Fitness.Body" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/trainer_schedule_label" android:textAppearance="@style/TextAppearance.Fitness.CardTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_jordan_schedule" android:textAppearance="@style/TextAppearance.Fitness.Body" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/follow_jordan_button" style="@style/Widget.Fitness.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/follow_this_plan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fitness.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_page">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sample_profile" android:textAppearance="@style/TextAppearance.Fitness.Metadata" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_alex" android:textAppearance="@style/TextAppearance.Fitness.CardTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/trainer_alex_plan" android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_alex_detail" android:textAppearance="@style/TextAppearance.Fitness.Metadata" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_alex_description" android:textAppearance="@style/TextAppearance.Fitness.Body" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/trainer_schedule_label" android:textAppearance="@style/TextAppearance.Fitness.CardTitle" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:text="@string/trainer_alex_schedule" android:textAppearance="@style/TextAppearance.Fitness.Body" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/follow_alex_button" style="@style/Widget.Fitness.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/follow_this_plan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
