<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_page"
        android:paddingBottom="@dimen/space_sm">

        <ImageButton
            android:id="@+id/recommendation_back_button"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_back"
            android:padding="@dimen/space_md"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/recommendation_title"
            android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_page"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_page"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recommendation_subtitle"
                android:textAppearance="@style/TextAppearance.Fitness.Metadata" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fitness.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                app:cardBackgroundColor="@color/color_selection">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_page">

                    <TextView
                        android:id="@+id/recommendation_match"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/match_format"
                        android:textColor="@color/color_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recommendation_plan_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/recommendation_title"
                        android:textAppearance="@style/TextAppearance.Fitness.PageTitle" />

                    <TextView
                        android:id="@+id/recommendation_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textAppearance="@style/TextAppearance.Fitness.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:text="@string/why_it_fits"
                android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />

            <TextView
                android:id="@+id/recommendation_reasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:lineSpacingExtra="4dp"
                android:textAppearance="@style/TextAppearance.Fitness.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:text="@string/weekly_schedule"
                android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fitness.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <TextView
                    android:id="@+id/recommendation_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:padding="@dimen/space_page"
                    android:textAppearance="@style/TextAppearance.Fitness.Body" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_plan_button"
                style="@style/Widget.Fitness.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:text="@string/save_this_plan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/change_answers_button"
                style="@style/Widget.Fitness.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/start_over" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recommendation_trainers_button"
                style="@style/Widget.Fitness.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/explore_trainers" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recommendation_music_button"
                style="@style/Widget.Fitness.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/open_music" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
