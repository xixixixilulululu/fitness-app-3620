<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_page"
        android:paddingTop="@dimen/space_section"
        android:paddingEnd="@dimen/space_page"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:id="@+id/rewards_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rewards_title"
            android:textAppearance="@style/TextAppearance.Fitness.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/rewards_subtitle"
            android:textAppearance="@style/TextAppearance.Fitness.Metadata" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Fitness.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            app:cardBackgroundColor="@color/color_reward">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_page">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reward_points"
                    android:textAppearance="@style/TextAppearance.Fitness.Metadata" />

                <TextView
                    android:id="@+id/reward_points_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/points_format"
                    android:textAppearance="@style/TextAppearance.Fitness.PageTitle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fitness.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:id="@+id/completed_workouts_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/count_format"
                        android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/completed_workouts"
                        android:textAppearance="@style/TextAppearance.Fitness.Metadata" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Fitness.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:id="@+id/streak_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/streak_placeholder"
                        android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/current_streak"
                        android:textAppearance="@style/TextAppearance.Fitness.Metadata" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/next_milestone"
            android:textAppearance="@style/TextAppearance.Fitness.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Fitness.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <TextView
                android:id="@+id/milestone_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_page"
                android:text="@string/milestone_first"
                android:textAppearance="@style/TextAppearance.Fitness.Body" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
